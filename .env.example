DATABASE_URL=sqlite:///./data/weekly_report.db
UPLOAD_DIR=./data/uploads
TEMP_DIR=./data/temp

OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:1.7b
EMBEDDING_MODEL=bge-m3
OLLAMA_TIMEOUT_SECONDS=900

# Leave QDRANT_URL blank for embedded local storage. Set it to http://qdrant:6333 in Docker/VM mode.
QDRANT_URL=
QDRANT_PATH=./data/qdrant
QDRANT_COLLECTION=tein_document_chunks
EMBEDDING_BATCH_SIZE=8
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=180
RAG_TOP_K=12
RAG_MIN_SEMANTIC_SCORE=0.48

MAX_UPLOAD_MB=30
MAX_PDF_PAGES=100
TEXT_CHUNK_SIZE=5000
DISK_USAGE_LIMIT_PERCENT=80
MIN_FREE_DISK_GB=15

# Optional: set an absolute executable path when soffice is not on PATH.
# Leave blank to auto-detect a standard Windows LibreOffice installation.
SOFFICE_PATH=
NODE_EXECUTABLE=
CONVERSION_TIMEOUT_SECONDS=120
